{
  "name": "arena-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "api": "tsx watch api/server.ts",
    "db:start": "spacetime start",
    "db:publish": "spacetime publish --module-path server --server local arena -y",
    "db:reset": "spacetime publish --module-path server --server local arena -y --delete-data",
    "db:generate": "spacetime generate --lang typescript --out-dir client/src/module_bindings --module-path server -y",
    "test": "tsx --test shared/*.test.ts client/src/input/*.test.ts sim/*.test.ts",
    "balance": "tsx sim/balance.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
