# Copy to .env and fill in. Read by the api/ proxy only; never sent to the browser.
ANTHROPIC_API_KEY=
# Optional: other designer backends for `npm run bench`, and DESIGNER=gemini|cerebras|groq to use one in the game
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
DESIGNER=claude
# Optional: speech-to-text and battle cries. Without it the browser's speech recognition is used and troops stay quiet
CARTESIA_API_KEY=
# Optional: troop sprites (FLUX.1 schnell + BiRefNet). Without it troops keep their placeholder tokens
FAL_KEY=
